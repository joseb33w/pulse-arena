# Pulse Arena backend configuration.
#
# This is a Godot web game, not a Node/Vite app — there is no runtime .env. These
# values are baked into the static web build in `web/bridge.js`. They are listed
# here so a maintainer knows what the multiplayer layer talks to.
#
# Only Supabase **Realtime broadcast** is used: a public channel `game:<room>`.
# No database tables, no auth, no RLS — broadcast messages are ephemeral. The
# publishable key is safe to ship in the browser.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
