; Pulse Arena — Godot 4.6.3 low-poly first-person multiplayer shooter.
; Compatibility/WebGL2 renderer (required for mobile browsers), nothreads web
; export. Serverless multiplayer over Supabase Realtime broadcast (see net.gd).

config_version=5

[application]

config/name="Pulse Arena"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
boot_splash/show_image=false

[autoload]

Net="*res://net.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation="sensor"

